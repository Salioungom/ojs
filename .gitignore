!.env.testing
!.env.local

# Build directories
/build
/js/build
/js/build.js
/js/build_frontend.js
/js/hot-updates
/styles/build.css
/styles/build_frontend.css

# Dependencies
/node_modules
/vendor
/plugins/*/vendor
/plugins/*/node_modules

