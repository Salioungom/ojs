{
    "name": "ojs/ojs",
    "description": "Open Journal Systems",
    "type": "project",
    "require": {
        "php": ">=8.1.0",
        "composer/installers": "^2.3"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "composer/installers": true
        },
        "preferred-install": "dist",
        "secure-http": false
    },
    "repositories": [
        {
            "type": "composer",
            "url": "https://packagist.org"
        },
        {
            "type": "path",
            "url": "plugins/generic/premiumSubmissionHelper"
        }
    ],
    "require-dev": {
        "squizlabs/php_codesniffer": "^3.13"
    }
}
