# Configuration de l'application
APP_ENV=local
APP_DEBUG=true
APP_KEY=

# Configuration de la base de données
DB_CONNECTION=mysql
DB_HOST=139.59.152.39
DB_PORT=3306
DB_DATABASE=ojs
DB_USERNAME=ojs
DB_PASSWORD=Passer@1234

# Configuration de l'API du plugin
PREMIUM_SUBMISSION_HELPER_API_KEY=votre_cle_api_ici
PREMIUM_SUBMISSION_HELPER_API_URL=https://api.exemple.com/v1
PREMIUM_SUBMISSION_HELPER_RATE_LIMIT=150
PREMIUM_SUBMISSION_HELPER_DEBUG=false

# Configuration des logs
LOG_CHANNEL=stack
LOG_LEVEL=debug

# Configuration du cache
CACHE_DRIVER=file
SESSION_DRIVER=file
QUEUE_CONNECTION=sync

# Configuration du courrier électronique
MAIL_MAILER=smtp
MAIL_HOST=mailhog
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Configuration du cache
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Configuration de la file d'attente
QUEUE_CONNECTION=sync

# Configuration de la session
SESSION_DRIVER=file
SESSION_LIFETIME=120

# Configuration de la localisation
APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_TIMEZONE=Senegal/Dakar

# Configuration du débogage
DEBUGBAR_ENABLED=false

# Configuration de la sécurité
APP_DEBUG=false
APP_URL=http://localhost

# Configuration du cache
CACHE_DRIVER=file
SESSION_DRIVER=file
QUEUE_DRIVER=sync

# Configuration de la mémoire
PHP_MEMORY_LIMIT=256M

# Configuration de l'upload
UPLOAD_MAX_FILESIZE=20M
POST_MAX_SIZE=20M
MAX_EXECUTION_TIME=300

# Configuration de l'API externe (exemple)
EXTERNAL_API_BASE_URL=https://api.exemple.com
EXTERNAL_API_TIMEOUT=30
EXTERNAL_API_RETRY_ATTEMPTS=3

# Configuration des services tiers (optionnel)
# GOOGLE_ANALYTICS_ID=
# MIX_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
# MIX_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

# Configuration du débogage Xdebug (désactivé en production)
XDEBUG_MODE=off
XDEBUG_CONFIG="client_host=host.docker.internal client_port=9003 start_with_request=yes"
