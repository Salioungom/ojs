# Configuration de l'environnement de test

# Application
APP_ENV=testing
APP_DEBUG=true
APP_KEY=base64:testkey1234567890123456789012345678
APP_URL=http://139.59.152.39

# Base de données de test (utilise la base de données distante)
DB_CONNECTION=mysql
DB_HOST=139.59.152.39
DB_PORT=3306
DB_DATABASE=ojs_test
DB_USERNAME=ojs
DB_PASSWORD=Passer@1234

# Cache
CACHE_DRIVER=array
SESSION_DRIVER=array
QUEUE_CONNECTION=sync

# Mail
MAIL_MAILER=log
MAIL_FROM_ADDRESS=test@example.com
MAIL_FROM_NAME="OJS Test"

# Configuration du plugin pour les tests
PREMIUM_SUBMISSION_HELPER_API_KEY=test_key_12345
PREMIUM_SUBMISSION_HELPER_API_URL=http://139.59.152.39/api
PREMIUM_SUBMISSION_HELPER_RATE_LIMIT=1000
PREMIUM_SUBMISSION_HELPER_DEBUG=true

# Logging
LOG_CHANNEL=stderr
LOG_LEVEL=debug

# Configuration des tests
TEST_TOKEN=test_environment_token_123

# Configuration du serveur SSH (si nécessaire pour les déploiements)
SSH_HOST=139.59.152.39
SSH_USER=salioungom
SSH_PASSWORD=ngom@1234
SSH_PORT=22

# Désactivation du débogage Xdebug pour les tests
XDEBUG_MODE=off
